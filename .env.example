# Public Supabase browser configuration. The anon key is intended for client
# use; authorization is enforced by Row Level Security and database functions.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional comma-separated production sign-in allowlist.
VITE_ALLOWED_EMAILS=

# Do not place provider secret keys in VITE_* variables: Vite embeds them in
# the browser bundle. AI generation uses its mock implementation by default.
